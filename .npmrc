shamefully-hoist=true
clang=0
# Forces electron/rebuild to use gcc/g++ instead of clang on Linux and msvc on Windows

# No `msvs_version` on purpose. pnpm passes every key in this file to node-gyp,
# and a pinned year makes node-gyp reject every other Visual Studio, newer ones
# included. Left unset, node-gyp picks the newest installation that has the C++
# build tools (2019, 2022 and 2026 are supported). To force one for a single
# command, set the npm_config_msvs_version environment variable instead.
